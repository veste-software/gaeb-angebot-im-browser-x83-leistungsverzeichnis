# Names only. Values live in the Cloudflare Pages settings (secrets) or a local, uncommitted .env.

# Build time (static site)
SITE_URL=
SITE_BASE=
# Public Ed25519 key (hex) the browser uses to verify unlock tokens
PUBLIC_UNLOCK_KEY=
# Optional, cookie-free analytics; leave empty to load nothing
PUBLIC_CF_BEACON_TOKEN=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=

# Cloudflare Pages Functions (functions/api/*), test mode until the owner goes live
STRIPE_SECRET_KEY=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_YEAR=
# Private Ed25519 key (hex) that signs unlock tokens
UNLOCK_SIGNING_KEY=
