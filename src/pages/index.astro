---
import Base from '../layouts/Base.astro';
import PricingTool from '../components/PricingTool';
import { url } from '../lib/paths';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'LV-Bepreiser',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Alle Systeme mit aktuellem Browser',
  inLanguage: 'de',
  description: 'X83-Leistungsverzeichnis im Browser öffnen, Einheitspreise eintragen und als X84-Angebot speichern. Die Datei wird nicht hochgeladen.',
  offers: [
    { '@type': 'Offer', name: 'Einzelangebot (X84-Export für ein LV)', price: '19.00', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Jahrespass (365 Tage)', price: '79.00', priceCurrency: 'EUR' },
  ],
};
---
<Base
  jsonLd={jsonLd}
  title="X83-Datei öffnen, bepreisen und als X84 abgeben – im Browser"
  description="GAEB-Leistungsverzeichnis (X83) im Browser öffnen, Einheitspreise eintragen, Summen prüfen und als X84-Angebot speichern. Ohne Installation, die Datei bleibt auf Ihrem Rechner."
>
  <section class="wrap intro">
    <div class="intro__text">
      <span class="eyebrow">GAEB DA XML 3.1–3.3 · X83 → X84</span>
      <h1>X83-Datei ausfüllen und als X84 abgeben</h1>
      <p class="lead">Leistungsverzeichnis öffnen, Einheitspreise eintragen, Summen prüfen – und die fertige X84-Datei für die Vergabeplattform speichern. Ohne Installation, ohne Konto.</p>
    </div>
    <img class="intro__art" src={url('art/hero.svg')} width="460" height="276" alt="" />
  </section>

  <section class="wrap tool-section" aria-label="Leistungsverzeichnis bepreisen">
    <PricingTool client:load />
    <img class="intro-art-phone" src={url('art/hero.svg')} width="460" height="276" alt="" />
  </section>

  <section class="wrap steps" aria-labelledby="steps-title">
    <h2 id="steps-title">So läuft es ab</h2>
    <ol class="steps-lv">
      <li>
        <img src={url('art/spot-1.svg')} width="200" height="200" alt="" loading="lazy" />
        <span class="oz">01</span>
        <div><h3>Datei öffnen</h3><p>Ihr Leistungsverzeichnis erscheint als Tabelle. Die Datei wird nur in Ihrem Browser gelesen.</p></div>
        <span class="price">0,00&nbsp;€</span>
      </li>
      <li>
        <img src={url('art/spot-2.svg')} width="200" height="200" alt="" loading="lazy" />
        <span class="oz">02</span>
        <div><h3>Preise eintragen</h3><p>Summen und fehlende Positionen sehen Sie sofort. Drucken und als PDF speichern.</p></div>
        <span class="price">0,00&nbsp;€</span>
      </li>
      <li>
        <img src={url('art/spot-3.svg')} width="200" height="200" alt="" loading="lazy" />
        <span class="oz">03</span>
        <div><h3>X84 abgeben</h3><p>Die geprüfte Datei für die Vergabeplattform herunterladen.</p></div>
        <span class="price">19,00&nbsp;€ netto</span>
      </li>
    </ol>
  </section>

  <section class="wrap facts">
    <h2>Was kostet es, was wird gelesen?</h2>
    <div class="facts__grid">
      <div>
        <p><strong>Kostenlos:</strong> öffnen, bepreisen, prüfen, Summen, Druckansicht als PDF. <strong>Kostenpflichtig:</strong> nur der X84-Download, 19&nbsp;€ netto je Angebot oder 79&nbsp;€ netto für ein Jahr, kein Abo. <a href={url('preise')}>Mehr zu den Preisen</a></p>
        <p class="muted">Ob eine Vergabestelle Ihr Angebot annimmt, kann das Werkzeug nicht beurteilen.</p>
      </div>
      <div class="formats">
        <p><strong>Liest:</strong> X83 (GAEB DA XML 3.1, 3.2, 3.3)</p>
        <p><strong>Schreibt:</strong> X84 in derselben Version</p>
        <p><strong>Nicht:</strong> D83, P83, ÖNORM</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: var(--s-5); padding-top: var(--s-5); }
  .intro h1 { max-width: 20ch; }
  @media (max-width: 899px) { .lead { font-size: 1.125rem; } }
  .steps, .facts { padding-bottom: var(--s-6); }
  .facts p { max-width: var(--measure); }
  @media (min-width: 900px) { .intro { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
</style>
