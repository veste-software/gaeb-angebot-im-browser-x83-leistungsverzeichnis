<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC test file, hand-written, not an official GAEB sample -->
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.3">
  <GAEBInfo>
    <Version>3.3</Version>
    <VersDate>2021-05</VersDate>
    <ProgSystem>Testdatei</ProgSystem>
  </GAEBInfo>
  <PrjInfo>
    <NamePrj>Malerarbeiten Grundschule Süd</NamePrj>
    <LblPrj>Außenanstrich und Flurbeschichtung</LblPrj>
    <Cur>EUR</Cur>
  </PrjInfo>
  <Award>
    <DP>83</DP>
    <OWN>
      <Address>
        <Name1>Stadt Beispielhausen, Hochbauamt</Name1>
      </Address>
    </OWN>
    <BoQ ID="BoQ01">
      <BoQInfo>
        <Name>LV Maler</Name>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length></BoQBkdn>
        <BoQBkdn><Type>Item</Type><Length>4</Length></BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy ID="C01" RNoPart="01">
          <LblTx><p><span>Vorbereitende Arbeiten</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I0101" RNoPart="0010">
                <Qty>125.500</Qty>
                <QU>m²</QU>
                <Description><CompleteText>
                  <OutlineText><OutlTxt><TextOutlTxt><span>Untergrund reinigen</span></TextOutlTxt></OutlTxt></OutlineText>
                  <DetailTxt><Text><p><span>Fassadenflächen abkehren und von Staub, Moos und losen Teilen befreien.</span></p></Text></DetailTxt>
                </CompleteText></Description>
              </Item>
              <Item ID="I0102" RNoPart="0020">
                <Qty>40</Qty>
                <QU>m</QU>
                <Description><CompleteText>
                  <OutlineText><OutlTxt><TextOutlTxt><span>Fensterbänke abkleben</span></TextOutlTxt></OutlTxt></OutlineText>
                </CompleteText></Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="C02" RNoPart="02">
          <LblTx><p><span>Beschichtung</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="I0201" RNoPart="0010">
                <Qty>310.250</Qty>
                <QU>m²</QU>
                <Description><CompleteText>
                  <OutlineText><OutlTxt><TextOutlTxt><span>Fassadenfarbe, zweifach gestrichen</span></TextOutlTxt></OutlTxt></OutlineText>
                  <DetailTxt><Text><p><span>Silikatfarbe, weiß, Größe nach Muster des Auftraggebers.</span></p></Text></DetailTxt>
                </CompleteText></Description>
              </Item>
              <Item ID="I0202" RNoPart="0020">
                <Qty>1</Qty>
                <QU>psch</QU>
                <Description><CompleteText>
                  <OutlineText><OutlTxt><TextOutlTxt><span>Gerüst vorhalten, Straßenseite</span></TextOutlTxt></OutlTxt></OutlineText>
                </CompleteText></Description>
              </Item>
              <Item ID="I0203" RNoPart="0030">
                <Qty>18.750</Qty>
                <QU>m²</QU>
                <Description><CompleteText>
                  <OutlineText><OutlTxt><TextOutlTxt><span>Flurwände, Dispersionsfarbe</span></TextOutlTxt></OutlTxt></OutlineText>
                </CompleteText></Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
  </Award>
</GAEB>
